# hearth-board.service: the operator's board (docs/interfaces/BOARD.md), installed by home/board.
# Runs as hearth-board, never root or an agent (docs/decisions/0013), from root's venv. It reads each
# agent's status through the group grant on /run/hearth/<agent>, and serves the page on a socket
# whose directory only hearth-operators (the operator's proxy) can enter.
[Unit]
Description=Hearth board (the operator's page)
After=network-online.target

[Service]
User=hearth-board
# The page's socket takes the board's primary group, which the operator's proxy is in; the agents'
# status directories are granted to hearth-board, a supplementary group here. (A setgid
# RuntimeDirectory doesn't hold: systemd puts its group and mode back each time it starts this.)
Group=hearth-operators
SupplementaryGroups=hearth-board
Environment=PATH=/usr/bin:/bin LANG=C.UTF-8
RuntimeDirectory=hearth-board
RuntimeDirectoryMode=0750
# The operator's sign-in for Talk (hearth.talk): a token only this user can read, never the password.
StateDirectory=hearth-board
StateDirectoryMode=0700
ExecStart=/opt/hearth/venv/bin/python -I -m hearth.board --socket /run/hearth-board/board.sock --operator /var/lib/hearth-board/operator.json
Restart=on-failure
RestartSec=10
# 78: refused to start (as root, as an agent, or in an open directory). A person owes a step.
RestartPreventExitStatus=78
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
