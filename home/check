#!/usr/bin/env -S -i /bin/bash --noprofile --norc
# home/check — run AS THE TENANT. Verifies every line of home/inventory by effect.
# Prints one line per item: GREEN | RED | ABSENT (declared) | KNOWN | PENDING | SKIP, then exits 0
# only if no item is RED, PENDING or SKIP. PENDING is a step a person still owes (e.g. Front Desk's
# identity, which provision leaves to Will).
# The shebang clears the environment before bash starts, so nothing from the caller reaches the
# script: no sentinel to forge, and no BASH_ENV, which bash would source before any line here ran.
# Everything the checks need is rebuilt below from the passwd entry of whoever is running it.
#
# usage: home/check [--no-model] [inventory]
set -u
USER=$(/usr/bin/id -un); LOGNAME=$USER
HOME=$(/usr/bin/getent passwd "$USER" | /usr/bin/cut -d: -f6)
PATH="/usr/bin:/bin"; LANG=C.UTF-8
# Nothing the tenant can write is on PATH: the judged party must not choose its judge's tools.
# The one tenant binary, claude, is named by its full path (provision installs it there).
CLAUDE="$HOME/.local/bin/claude"
# Where Claude Code keeps its own memory: auto-memory files under projects/*/memory/ and the user
# CLAUDE.md. Its auto-memory is on by default, so "memory absent" is a claim to test, not to declare.
MEM_HOME="$HOME"; CLAUDE_HOME="$MEM_HOME/.claude"
export USER LOGNAME HOME PATH LANG

NO_MODEL=0; [ "${1:-}" = "--no-model" ] && { NO_MODEL=1; shift; }
# Fixed, not derived from $0: a copy of this script in the tenant's home still reads the installed
# list, so stripping lines from its own copy of the inventory achieves nothing.
DEFAULT_INV=/opt/hearth/home/inventory
INV=${1:-$DEFAULT_INV}
LEDGER="$HOME/.hearth/ledger.jsonl"
# Items the run must contain, with the check each must use, whatever the list says: an inventory that
# drops one, or swaps its check for a weaker one (e.g. declared_absent), can't pass.
REQUIRED="user:user_exists home_dir:home_private claude_bin:claude_runs oauth:model_turn custody:others_unreadable custody_in:inbound_custody sudo:no_sudo judge:judge_not_tenant cc_memory:no_memory memory:plugin_match:tapestry channel:plugin_match:frontdesk channel_home:frontdesk_home other_plugins:other_plugins loan_reach:loan_reach"
# Membership in any of these is root without a sudoers rule. provision denies the same list.
ROOT_GROUPS="sudo admin wheel docker lxd libvirt"
ATTEST_DIR=/opt/hearth/home/attest; ATTEST_OWNER=root
bad=0
sha() { [ -r "$1" ] && sha256sum "$1" | cut -c1-64 || echo unreadable; }
# Provenance, for a reader comparing runs. It is printed by the script, so a copy can fake it:
# it helps an honest reader spot a copy, it does not stop a dishonest one (README: accepted results).
printf 'check %s sha256 %s | inventory %s sha256 %s\n' \
  "$(readlink -f "$0")" "$(sha "$(readlink -f "$0")")" "$INV" "$(sha "$INV")"
# Any other inventory is for negative controls only: its lines are reported, but the run can never
# pass, or a tenant could grade itself against a list without the judge line (or with nothing in it).
if [ "$(readlink -m "$INV")" != "$DEFAULT_INV" ]; then
  printf 'RED    %-11s not the installed inventory (%s); result is for negative controls only\n' inventory "$INV"
  bad=1
fi
if [ ! -r "$INV" ]; then
  printf 'RED    %-11s %s is missing or unreadable\n' inventory "$INV"
  bad=1
fi

mode_of() { stat -c '%a' "$1" 2>/dev/null; }
owner_of() { stat -c '%U' "$1" 2>/dev/null; }

c_user_exists() {
  # names, not a hard-coded uid: useradd assigns it. arg = required extra groups, comma-separated
  [ "$(getent passwd "$USER" | cut -d: -f3)" = "$(id -u)" ] || { echo "passwd/uid mismatch"; return 1; }
  [ "$(id -gn)" = "$USER" ] || { echo "primary group $(id -gn), want $USER"; return 1; }
  for g in $(echo "${1:-}" | tr ',' ' '); do
    case " $(id -nG) " in *" $g "*) ;; *) echo "not in group $g (groups: $(id -nG))"; return 1;; esac
  done
  echo "$USER:$(id -gn) groups: $(id -nG)"
}
# home_private[:acl,acl...]  owner is the tenant, group/other get nothing, and the named-user/group
# ACL entries are exactly the declared ones (e.g. user:will:--x so a publisher dir can be read).
c_home_private() {
  [ "$(owner_of "$HOME")" = "$USER" ] || { echo "owner $(owner_of "$HOME")"; return 1; }
  command -v getfacl >/dev/null || { echo "getfacl not found (acl package): can't read the ACL"; return 1; }
  want=$(echo "${1:-}" | tr ',' '\n' | sed '/^$/d' | sort)
  have=$(getfacl -cp "$HOME" 2>/dev/null | grep -E '^(user|group):[^:]+:' | sort)
  [ "$have" = "$want" ] || { echo "ACL entries [$(echo $have)], declared [$(echo $want)]"; return 1; }
  # with an ACL, the group bits shown by stat are the mask; check the real owning-group entry
  g=$(getfacl -cp "$HOME" 2>/dev/null | grep -E '^group::' | cut -d: -f3)
  o=$(getfacl -cp "$HOME" 2>/dev/null | grep -E '^other::' | cut -d: -f3)
  [ "$g" = "---" ] && [ "$o" = "---" ] || { echo "group::$g other::$o, want ---"; return 1; }
  echo "$USER, group/other ---, ACL [$(echo $have)]"
}
c_claude_runs() {
  # arg = pinned version. The binary must resolve inside the tenant's own home (per-tenant install).
  p=$CLAUDE; [ -e "$p" ] || { echo "no claude at $p"; return 1; }
  r=$(readlink -f "$p"); [ -x "$r" ] || { echo "$p -> $r not executable"; return 1; }
  case "$r" in "$HOME"/*) ;; *) echo "$r is outside $HOME (not the tenant's own install)"; return 1;; esac
  [ "$(owner_of "$r")" = "$USER" ] || { echo "$r owned by $(owner_of "$r")"; return 1; }
  v=$("$CLAUDE" --version 2>&1) || { echo "claude --version failed: $v"; return 1; }
  [ -z "${1:-}" ] || [ "${v%% *}" = "$1" ] || { echo "version '$v', pinned $1"; return 1; }
  echo "$r ($v)"
}
c_model_turn() {
  [ $NO_MODEL = 1 ] && return 2
  [ -x "$CLAUDE" ] || { echo "no claude at $CLAUDE"; return 1; }
  out=$(cd "$HOME" && timeout 120 "$CLAUDE" -p --model sonnet --output-format json \
        "Reply with exactly: HOME-OK" 2>&1) || { echo "turn failed: $(echo "$out" | tail -c 300)"; return 1; }
  res=$(printf '%s' "$out" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("result","").strip())' 2>/dev/null)
  [ "$res" = "HOME-OK" ] || { echo "result was: ${res:-<unparsed>}"; return 1; }
  echo "HOME-OK"
}
c_ledger_writable() {
  [ -f "$LEDGER" ] || { echo "$LEDGER missing"; return 1; }
  [ "$(owner_of "$LEDGER")" = "$USER" ] && [ "$(mode_of "$LEDGER")" = 644 ] \
    || { echo "$(owner_of "$LEDGER") $(mode_of "$LEDGER"), want $USER 644"; return 1; }
  d=$(dirname "$LEDGER")
  [ "$(owner_of "$d")" = "$USER" ] && [ $(( 8#$(mode_of "$d") & 8#022 )) = 0 ] \
    || { echo "dir $d $(owner_of "$d") $(mode_of "$d")"; return 1; }
  echo "$USER 644"
}
c_others_unreadable() {
  leaks=""; tested=0
  # every other login user's home, from passwd (not a /home glob: a sandbox may stub /home)
  while IFS=: read -r u _ uid _ _ h _; do
    [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] || continue
    [ "$u" = "$USER" ] && continue
    [ -d "$h" ] || continue
    [ "$(owner_of "$h")" = "$u" ] || continue   # stub, not that user's real home
    tested=$((tested+1))
    ls -A "$h" >/dev/null 2>&1 && leaks="$leaks $h"
  done < <(getent passwd)
  [ -z "$leaks" ] || { echo "can list:$leaks"; return 1; }
  # zero real homes seen means a sandbox hid them: that proves nothing, so it is not green
  [ $tested -gt 0 ] || { echo "no other real home visible to test against (sandboxed run?)"; return 1; }
  echo "$tested other homes, none listable"
}
c_no_sudo() {
  g=" $(id -nG) "
  for r in $ROOT_GROUPS; do
    case "$g" in *" $r "*) echo "in root-equivalent group $r:$g"; return 1;; esac
  done
  # A sudoers rule needs no group. From inside, sudo 1.9.15 answers a user with NO rules and a user
  # WITH password rules identically ("a password is required", rc 1; measured as refsdal and as
  # will), and under NoNewPrivileges it doesn't read sudoers at all. So the tenant can only rule out
  # NOPASSWD rules itself (sudo -n -l rc 0 lists them). "No rules" is proved root-side: provision runs
  # `sudo -l -U <tenant>` and writes a root-owned attestation; it counts only while no sudoers file
  # has changed since. (sudoers from LDAP/sssd isn't covered; this host has none.)
  if command -v sudo >/dev/null; then
    out=$(LC_ALL=C sudo -n -l 2>&1); rc=$?
    [ $rc = 0 ] && { echo "sudo -n -l lists rules: $(echo "$out" | tail -n 3 | tr '\n' ' ')"; return 1; }
  fi
  att=$ATTEST_DIR/$USER.sudo
  [ -f "$att" ] || { echo "no root-side attestation ($att): from inside, no-rules and password-rules look the same"; return 1; }
  [ "$(owner_of "$att")" = "$ATTEST_OWNER" ] && [ "$(owner_of "$ATTEST_DIR")" = "$ATTEST_OWNER" ] \
    || { echo "$att or its dir not owned by $ATTEST_OWNER"; return 1; }
  grep -q '^not-allowed ' "$att" || { echo "attestation says: $(head -n 1 "$att")"; return 1; }
  for f in /etc/sudoers /etc/sudoers.d /etc/sudoers.d/*; do
    [ -e "$f" ] && [ "$f" -nt "$att" ] && { echo "$f changed after the attestation ($(head -n 1 "$att")); re-attest"; return 1; }
  done
  echo "groups:$g; root-side: $(head -n 1 "$att"); sudoers unchanged since"
}
c_declared_absent() { return 3; }
# Memory declared absent must be absent by effect. Buster's first turn (main 68890beb) had Claude
# Code's auto-memory write three files under ~/.claude/projects/-home-buster/memory/ while this line
# read "declared absent".
# The set is what Claude Code documents as loaded for a session whose cwd is the home (docs read
# 2026-10-05, not verified against 2.1.288 itself). The tenant owns all of it and is the judged
# party, so: any entry counts, links and other non-files included; a place the check can't look
# into is RED, never "nothing found"; and a relocated auto-memory dir is RED (it can't be found).
c_no_memory() {
  found=""
  for p in "$MEM_HOME/CLAUDE.md" "$MEM_HOME/CLAUDE.local.md" "$MEM_HOME/AGENTS.md" \
           "$CLAUDE_HOME/CLAUDE.md" "$CLAUDE_HOME/CLAUDE.local.md" \
           /home/CLAUDE.md /home/CLAUDE.local.md /CLAUDE.md /CLAUDE.local.md /etc/claude-code/CLAUDE.md; do
    { [ -e "$p" ] || [ -L "$p" ]; } && found="$found $p"
  done
  for s in "$CLAUDE_HOME/settings.json" "$CLAUDE_HOME/settings.local.json" /etc/claude-code/managed-settings.json; do
    { [ -e "$s" ] || [ -L "$s" ]; } || continue
    [ -r "$s" ] || { echo "can't read $s, so can't rule out memory settings in it"; return 1; }
    # Parsed, not grepped: the tenant writes this file, and JSON lets a key be spelled with \u escapes
    # that a byte grep can't see (Ash's {"autoMemory\u0044irectory": ...} on #42). Keys are looked for
    # at any depth; anything that doesn't parse as JSON is RED, never "nothing found".
    k=$(/usr/bin/python3 -I -c '
import json, os, stat, sys
def keys(o):
    if isinstance(o, dict):
        for k, v in o.items():
            yield k
            yield from keys(v)
    elif isinstance(o, list):
        for v in o:
            yield from keys(v)
try:
    # O_NONBLOCK and a regular-file check on the open descriptor, not a test before opening: a FIFO
    # here would block open() and the judge would never return (Ash on #42), and a [ -f ] test
    # first leaves the tenant a window to swap the file for one.
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NONBLOCK)
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        print("not a regular file"); sys.exit(2)
    # Bounded: a sparse file costs the tenant no disk but would cost the judge its memory (Ash on
    # #42: 1 GiB sparse = 1.3 GB RSS). The read itself is capped, which also covers a file grown
    # after it was opened. (No apostrophes in this block: it is one single-quoted bash string.)
    BOUND = 1 << 20
    with os.fdopen(fd, "rb") as f:
        raw = f.read(BOUND + 1)
    if len(raw) > BOUND:
        print("too large (over %d bytes)" % BOUND); sys.exit(2)
    d = json.loads(raw)
except Exception as e:
    print("unparseable: %s" % type(e).__name__); sys.exit(2)
hit = sorted({k for k in keys(d) if k in ("autoMemoryDirectory", "claudeMd")})
print(" ".join(hit)); sys.exit(1 if hit else 0)' "$s" 2>&1); krc=$?
    case $krc in
      0) ;;
      1) found="$found $s($k)";;
      *) echo "can't rule out memory settings in $s: $k"; return 1;;
    esac
  done
  # Directories: -L follows links at every level (a linked memory/ or a linked MEMORY.md), and any
  # find error (a mode-000 dir, a loop) is RED. stderr is kept, never discarded.
  roots=""
  for d in "$CLAUDE_HOME/projects" "$CLAUDE_HOME/rules"; do
    { [ -e "$d" ] || [ -L "$d" ]; } && roots="$roots $d"
  done
  if [ -n "$roots" ]; then
    # shellcheck disable=SC2086
    out=$(find -L $roots \( -path "$CLAUDE_HOME/projects/*/memory/*" -o -path "$CLAUDE_HOME/rules/*" \) \
            ! -type d -print 2>&1); rc=$?
    [ $rc = 0 ] || { echo "couldn't look everywhere (find rc $rc): $(echo "$out" | head -n 3 | tr '\n' ' ')"; return 1; }
    [ -n "$out" ] && found="$found $(echo "$out" | head -n 5 | tr '\n' ' ')"
  fi
  [ -z "$found" ] || { echo "memory present:$found"; return 1; }
  echo "no CLAUDE.md/.local/AGENTS.md, auto-memory, rules or memory setting for a session in $MEM_HOME"
}
# Inbound custody: can anyone else read the tenant's home? Any other login account in a
# root-equivalent group can. That is Will's soft-boundary decision (discussions/SYNTHESIS-round1.md):
# accepted, not met, so it reports KNOWN, which never prints GREEN and doesn't fail the run.
# Finding no such account proves nothing, because other users' sudoers rules can't be read from
# here, so that case is RED until it is shown from outside.
c_inbound_custody() {
  who=""
  while IFS=: read -r u _ uid _ _ _ _; do
    [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] && [ "$u" != "$USER" ] || continue
    gs=" $(id -nG "$u" 2>/dev/null) "
    for r in $ROOT_GROUPS; do case "$gs" in *" $r "*) who="$who $u($r)"; break;; esac; done
  done < <(getent passwd)
  [ -n "$who" ] || { echo "no other account in a root-equivalent group, but sudoers rules for other users aren't readable as $USER: unverified, prove it from outside"; return 1; }
  echo "other accounts with root:$who. Not exclusive custody; accepted by Will's soft-boundary decision (discussions/SYNTHESIS-round1.md)"
  return 4
}
# What the loaned claude.ai login brings with it besides model access (Buster's turns 1-2): Will's
# claude.ai skills, synced into ~/.claude/skills/synced/, and his claude.ai connectors. Will chose to
# leave the token alone for now (connectors KNOWN, 2026-10-05), so this is KNOWN (never GREEN), and
# RED only if check can't look.
# Skills are listed by their SKILL.md name. Connectors are fetched per session and leave nothing on
# disk to read, so they are named as reachable, not enumerated (docs read 2026-10-05: on unless
# disableClaudeAiConnectors or ENABLE_CLAUDEAI_MCP_SERVERS=false; check reads neither).
# None on disk doesn't mean none loaned: a short -p run can end before the sync lands.
c_loan_reach() {
  d="$CLAUDE_HOME/skills/synced"; names=""
  if [ -e "$d" ] || [ -L "$d" ]; then
    out=$(find -L "$d" -mindepth 2 -maxdepth 2 -name SKILL.md -print 2>&1); rc=$?
    [ $rc = 0 ] || { echo "couldn't look in $d (find rc $rc): $(echo "$out" | head -n 3 | tr '\n' ' ')"; return 1; }
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      # tenant-written text goes to the reader's terminal: keep it to name characters. Opened
      # non-blocking (Ash on #47): a FIFO here would block open() and check would never return, as
      # on #42. A FIFO, device or directory just reads as no name, "?".
      n=$(dd if="$f" bs=4096 count=1 iflag=nonblock status=none 2>/dev/null | grep -m1 -E '^name:' | cut -d: -f2- | tr -cd 'A-Za-z0-9._-')
      names="$names ${n:-?}"
    done <<< "$out"
  fi
  n=$(echo $names | wc -w)
  echo "Will's claude.ai skills synced: $n$( [ "$n" = 0 ] || echo " [$(echo $names | tr ' ' '\n' | sort | head -n 20 | tr '\n' ' ' | sed 's/ $//')]"); claude.ai connectors: reachable, not enumerated. Accepted with the token (Will, 2026-10-05)"
  return 4
}
# the judged party must not be able to edit its judge: neither this script, the inventory, nor any
# directory above them may be writable by the tenant. Tested with -w as the tenant, by effect.
c_judge_not_tenant() {
  w=""
  for f in "$(readlink -f "$0")" "$(readlink -f "$INV")"; do
    p=$f
    while :; do
      [ -w "$p" ] && w="$w $p"
      [ "$p" = / ] && break
      p=$(dirname "$p")
    done
  done
  [ -z "$w" ] || { echo "writable by $USER:$(echo "$w" | tr ' ' '\n' | sort -u | tr '\n' ' ')"; return 1; }
  echo "$(readlink -f "$0") and inventory not writable by $USER"
}
# Hearth's plugins (docs/decisions/0009). The checks themselves are Python in the root-owned venv,
# run as the tenant: hearth.tenantcheck parses the tenant's settings and install records and compares
# the installed tree with root's export at the current pin. Its exit code is check's (0/1/4/5).
HEARTH_PY=/opt/hearth/venv/bin/python
tc() {
  [ -x "$HEARTH_PY" ] || { echo "no $HEARTH_PY (provision step 5b)"; return 1; }
  "$HEARTH_PY" -I -m hearth.tenantcheck "$@" 2>&1 | head -c 2000
  return "${PIPESTATUS[0]}"
}
c_plugin_match() { tc plugin_match "$1"; }
c_frontdesk_home() { tc frontdesk_home; }
c_other_plugins() { tc other_plugins; }

seen=" "
while IFS='|' read -r item kind owner issuer chk; do
  item=$(echo "$item" | xargs); chk=$(echo "$chk" | xargs); kind=$(echo "$kind" | xargs)
  case "$item" in ''|\#*) continue;; esac
  arg=""; case "$chk" in *:*) arg=${chk#*:}; chk=${chk%%:*};; esac
  seen="$seen$item:$chk ${arg:+$item:$chk:$arg }"   # with its argument too, so REQUIRED can pin one
  fn="c_$chk"
  if ! declare -F "$fn" >/dev/null; then printf 'RED    %-11s unknown check %s\n' "$item" "$chk"; bad=1; continue; fi
  msg=$($fn "$arg" 2>&1 </dev/null); rc=$?   # stdin is the inventory: a check that reads it (claude -p does) eats the rest
  if [ "$kind" = absent ] && [ $rc = 0 ] && [ "$chk" != declared_absent ]; then rc=3; msg="absent as declared: $msg"; fi
  case $rc in
    0) printf 'GREEN  %-11s %s\n' "$item" "$msg";;
    2) printf 'SKIP   %-11s (--no-model)\n' "$item"; bad=1;;
    3) printf 'ABSENT %-11s declared absent %s\n' "$item" "$msg";;
    4) printf 'KNOWN  %-11s %s\n' "$item" "$msg";;
    5) printf 'PENDING %-10s %s\n' "$item" "$msg"; bad=1;;
    *) printf 'RED    %-11s %s\n' "$item" "$msg"; bad=1;;
  esac
done < <([ -r "$INV" ] && cat "$INV")
# A filter over an empty set comes back clean whatever it asked, so absence is RED, item by item.
for r in $REQUIRED; do
  case "$seen" in *" $r "*) ;; *) printf 'RED    %-11s required as %s, not in the inventory that way\n' "${r%%:*}" "$r"; bad=1;; esac
done
exit $bad
