#!/usr/bin/env bash
# home/provision — run by Will with sudo. Creates a tenant from home/inventory and nothing else.
#
#   sudo home/provision buster            # do it
#   sudo home/provision --dry-run buster  # print what it would do, change nothing
#   sudo home/provision --upgrade buster  # also reinstall /opt/hearth/venv if it differs from this checkout
#
# Every step checks its own state first, so a re-run after a failure continues instead of
# duplicating. One gap: if it dies between useradd and the registry write (the next command), a
# re-run refuses the user as not its own. Then check by hand that /home/<tenant> is empty and
# write its uid to /var/lib/hearth/tenants/<tenant> as root, or userdel and start again. It never deletes or overwrites a tenant's file: if something exists with the wrong
# owner or mode it stops and says so, and a person decides.
#
# Not automated, on purpose: the OAuth login. It's Will's credential (a loan from his Max account),
# so provision prints the command and Will runs it himself.
#
# Choices this follows (asked of Will; changing any of them is a small edit):
#   - Claude Code per tenant, copied from root's sha256-checked store of the pinned version, with auto-update off
#   - memory declared absent in v0
#   - no sudo for the tenant
set -euo pipefail

DRY=0; UPGRADE=0
while :; do case "${1:-}" in
  --dry-run) DRY=1; shift;;
  --upgrade) UPGRADE=1; shift;;
  *) break;;
esac; done
T=${1:?usage: provision [--dry-run] [--upgrade] <tenant>}
CLAUDE_VERSION=2.1.288
# Root's own copy of the pinned binary, checked against Anthropic's published sha256 for this
# version (https://downloads.claude.ai/claude-code-releases/2.1.288/manifest.json, linux-x64). The
# old source, Will's ~/.local/share/claude/versions, is pruned by Claude Code's own updater (#60).
CLAUDE_SHA256=0298068b686e7fdbaf9402a7a587bb7f49c0b0e084de09f69145a0719207640c
CLAUDE_URL=https://downloads.claude.ai/claude-code-releases/$CLAUDE_VERSION/linux-x64/claude
CLAUDE_STORE=/opt/hearth/claude; STORE_OWNER=root
CLAUDE_SRC=$CLAUDE_STORE/$CLAUDE_VERSION
EXTRA_GROUPS=agents
READER=will                       # gets --x on the home, so it can read the published ledger

case "$T" in *[!a-z0-9_-]*|'') echo "bad tenant name: $T" >&2; exit 2;; esac
[ $DRY = 1 ] || [ "$(id -u)" = 0 ] || { echo "run with sudo" >&2; exit 2; }

run() { echo "+ $*"; [ $DRY = 1 ] || "$@"; }
as_t() { run sudo -u "$T" -H "$@"; }
die() { echo "STOP: $*" >&2; exit 1; }
# Inside the tenant's home, root does nothing. On a re-run the tenant has had the home and can have
# planted symlinks; chmod/install/cmp/grep as root would follow them to any file on the host. So every
# write under $H runs as the tenant (as_t) and every read or test runs as the tenant too (tq; in a dry
# run, as the caller, read only). A link can then only reach what the tenant could reach anyway.
# nolink refuses links outright, so a planted link is a STOP that a person sees, not a silent EPERM.
tq() { if [ $DRY = 1 ]; then "$@"; else sudo -u "$T" -H "$@"; fi; }
nolink() { local p; for p; do [ -L "$p" ] && die "$p is a symlink; provision doesn't follow links in a tenant's home"; done; return 0; }

# Only a user this script created may be touched again: an existing user it didn't create is
# someone's home, and provision would strip its ACLs. The record lives in a root-owned registry
# outside every home, holding the uid, so no tenant or other agent can forge or delete it (a marker
# inside the home could be made by its owner). This refusal reads only, so it comes first: it
# holds even on a host that would fail the prerequisites below.
REG=/var/lib/hearth/tenants      # REG/<tenant> holds the uid, written by the command after useradd
registered() {                   # root-owned, not writable by anyone else, and naming this uid
  local f=$REG/$1
  [ -f "$f" ] && [ ! -L "$f" ] && [ "$(stat -c %U "$f")" = root ] && [ "$(stat -c %U "$REG")" = root ] \
    && [ $(( 8#$(stat -c %a "$f") & 8#022 )) = 0 ] && [ $(( 8#$(stat -c %a "$REG") & 8#022 )) = 0 ] \
    && [ "$(cat "$f")" = "$(id -u "$1")" ]
}
if getent passwd "$T" >/dev/null; then
  registered "$T" || die "user $T exists and isn't in $REG with its uid (provision didn't create it); refusing to touch it"
fi

# 0. host prerequisites, before any change: provision needs setfacl, and check needs getfacl and an
#    env that takes -S. A missing one is a stop here, not a failure halfway through.
for c in setfacl getfacl; do
  PATH=/usr/bin:/bin command -v "$c" >/dev/null || die "$c not found in /usr/bin:/bin (install the acl package)"
done
/usr/bin/env -S -i /bin/true 2>/dev/null || die "/usr/bin/env has no -S (check's shebang needs coreutils 8.30 or later)"

# 1. user: own primary group, plus agents.
if getent passwd "$T" >/dev/null; then
  [ "$(id -gn "$T")" = "$T" ] || die "user $T exists with primary group $(id -gn "$T")"
  echo "= user $T exists (registered)"
else
  run install -d -o root -g root -m 755 /var/lib/hearth "$REG"
  run useradd --create-home --user-group --groups "$EXTRA_GROUPS" --shell /bin/bash "$T"
  [ $DRY = 1 ] && echo "+ write $REG/$T (uid)" || { umask 022; id -u "$T" > "$REG/$T"; }
fi
for g in $(echo "$EXTRA_GROUPS" | tr ',' ' '); do
  id -nG "$T" 2>/dev/null | tr ' ' '\n' | grep -qx "$g" || run usermod -aG "$g" "$T"
done
H=$(getent passwd "$T" | cut -d: -f6 || true); H=${H:-/home/$T}

# sudo: the tenant must not be in a root-equivalent group (docker, lxd and libvirt give root with no
# sudoers rule). Same list as check's ROOT_GROUPS. Rules in sudoers are checked by home/check.
for g in sudo admin wheel docker lxd libvirt; do
  id -nG "$T" 2>/dev/null | tr ' ' '\n' | grep -qx "$g" && die "$T is in group $g, which is root; HOME declares no sudo"
done

# 2. home: tenant-owned, group/other nothing, exactly one ACL entry (READER traverse).
run chown "$T:$T" "$H"
run chmod 700 "$H"
run setfacl -b "$H"
run setfacl -m "u:$READER:--x" "$H"

# 3. Claude Code, the tenant's own copy of the pinned version, copied from root's store.
#    The store is seeded once from Anthropic's download and verified on every run: a file there that
#    doesn't hash to CLAUDE_SHA256 is a STOP, never replaced. No tenant's file is in this path.
sha_ok() { [ "$(sha256sum < "$1" | cut -d' ' -f1)" = "$CLAUDE_SHA256" ]; }
# root's: owned by STORE_OWNER and writable by nobody else, as the entry itself (stat doesn't follow
# links). A link's own mode is always 0777 on Linux, so this rejects every link too.
rootish() { [ "$(stat -c %U "$1")" = "$STORE_OWNER" ] && [ $(( 8#$(stat -c %a "$1") & 8#022 )) = 0 ]; }
if [ -e "$CLAUDE_STORE" ] || [ -L "$CLAUDE_STORE" ]; then
  [ -d "$CLAUDE_STORE" ] && rootish "$CLAUDE_STORE" || die "$CLAUDE_STORE isn't a $STORE_OWNER-owned directory only $STORE_OWNER can write; fix by hand"
fi
if [ -e "$CLAUDE_SRC" ] || [ -L "$CLAUDE_SRC" ]; then
  [ -f "$CLAUDE_SRC" ] && rootish "$CLAUDE_SRC" \
    || die "$CLAUDE_SRC isn't a $STORE_OWNER-owned regular file only $STORE_OWNER can write; fix by hand"
  sha_ok "$CLAUDE_SRC" || die "$CLAUDE_SRC doesn't hash to $CLAUDE_SHA256; replace it by hand"
  echo "= $CLAUDE_SRC present, sha256 ok"
elif [ $DRY = 1 ]; then
  echo "+ download $CLAUDE_URL -> $CLAUDE_SRC ($STORE_OWNER 755), kept only if its sha256 is $CLAUDE_SHA256"
else
  [ -d "$CLAUDE_STORE" ] || install -d -m 755 "$CLAUDE_STORE"
  part=$(mktemp "$CLAUDE_STORE/.$CLAUDE_VERSION.XXXXXX")
  curl -sS --fail --proto =https -o "$part" "$CLAUDE_URL" || { rm -f "$part"; die "download of $CLAUDE_URL failed"; }
  sha_ok "$part" || { rm -f "$part"; die "$CLAUDE_URL doesn't hash to $CLAUDE_SHA256; not installed"; }
  chown "$STORE_OWNER:" "$part"; chmod 755 "$part"; mv "$part" "$CLAUDE_SRC"
  echo "+ $CLAUDE_SRC downloaded, sha256 ok"
fi
vdir=$H/.local/share/claude/versions
dst=$vdir/$CLAUDE_VERSION
link=$H/.local/bin/claude
nolink "$H/.local" "$H/.local/share" "$H/.local/share/claude" "$vdir" "$dst" "$H/.local/bin"
if tq test -e "$dst"; then
  # judged by the pinned hash, not by the store, so a dry run can judge it before the store exists
  [ "$(tq sha256sum "$dst" | cut -d' ' -f1)" = "$CLAUDE_SHA256" ] || die "$dst doesn't hash to $CLAUDE_SHA256 (the pinned $CLAUDE_VERSION)"
  echo "= $dst present, sha256 ok"
else
  as_t mkdir -p "$vdir" "$H/.local/bin"
  nolink "$H/.local" "$H/.local/share" "$H/.local/share/claude" "$vdir" "$H/.local/bin"
  # root only opens the source; the tenant writes the copy (to a temp name, so a failed copy never
  # looks like a finished one)
  [ $DRY = 1 ] && echo "+ copy $CLAUDE_SRC -> $dst (written by $T)" || \
    sudo -u "$T" -H sh -c 'umask 022; cat > "$1.part" && chmod 755 "$1.part" && mv "$1.part" "$1"' sh "$dst" < "$CLAUDE_SRC"
fi
if [ -L "$link" ] && [ "$(readlink "$link")" = "$dst" ]; then echo "= $link ok"
elif tq test -e "$link" || [ -L "$link" ]; then die "$link exists and isn't the pinned link"
else as_t ln -s "$dst" "$link"; fi
# pin: stop the background updater (believed: DISABLE_AUTOUPDATER in settings env; check proves the version)
settings=$H/.claude/settings.json
nolink "$H/.claude" "$settings"
if tq test -e "$settings"; then
  tq grep -q DISABLE_AUTOUPDATER "$settings" || die "$settings exists without DISABLE_AUTOUPDATER; add it by hand"
  tq grep -q '"autoMemoryEnabled": *false' "$settings" || die "$settings exists without \"autoMemoryEnabled\": false; add it by hand (memory is declared absent)"
  tq grep -q '"disableClaudeAiConnectors": *true' "$settings" && tq grep -q '"syncClaudeAiSkills": *false' "$settings" \
    || die "$settings exists without \"disableClaudeAiConnectors\": true and \"syncClaudeAiSkills\": false; add them by hand (the tenant must not reach the claude.ai account it borrows)"
  echo "= $settings present"
else
  as_t mkdir -p "$H/.claude"
  [ $DRY = 1 ] && echo "+ write $settings" || \
    sudo -u "$T" -H sh -c "umask 077; printf '%s\n' '{\"autoMemoryEnabled\": false, \"disableClaudeAiConnectors\": true, \"syncClaudeAiSkills\": false, \"syncClaudeAiPlugins\": false, \"env\": {\"DISABLE_AUTOUPDATER\": \"1\", \"CLAUDE_CODE_DISABLE_AUTO_MEMORY\": \"1\", \"ENABLE_CLAUDEAI_MCP_SERVERS\": \"false\"}}' > '$settings'"
fi

# 4. ledger: written only by the tenant, readable by READER through the home's --x.
ledger=$H/.hearth/ledger.jsonl
nolink "$H/.hearth" "$ledger"
as_t mkdir -p "$H/.hearth"
as_t chmod 755 "$H/.hearth"
tq test -e "$ledger" || as_t touch "$ledger"
nolink "$H/.hearth" "$ledger"
as_t chmod 644 "$ledger"
[ $DRY = 1 ] || [ "$(stat -c %U "$ledger")" = "$T" ] || die "ledger not owned by $T"

# 5. check + inventory: ROOT-owned, outside every tenant's home. The judged party must not be able
#    to edit its judge; check asserts this about itself (judge_not_tenant).
JUDGE=/opt/hearth/home
here=$(cd "$(dirname "$0")" && pwd)
run install -d -o root -g root -m 755 /opt/hearth "$JUDGE"
for f in check inventory turn; do
  if [ -e "$JUDGE/$f" ] && ! cmp -s "$here/$f" "$JUDGE/$f"; then
    die "$JUDGE/$f exists and differs from $here/$f (another revision?); replace it by hand"
  fi
  run install -o root -g root -m "$([ $f = inventory ] && echo 644 || echo 755)" "$here/$f" "$JUDGE/$f"
done

# 5b. Hearth's own interpreter, and its plugins at the pins (docs/decisions/0009). Root-owned and
#     read-only to tenants, like the judge: the tenant runs this code, it doesn't get to edit it.
#     - /opt/hearth/venv: the hearth package, from this checkout, with frontdesk and tapestry at the
#       commits pyproject pins. One venv for every tenant, so a pin bump moves them all (accepted).
#     - /opt/hearth/marketplace: the directory marketplace each tenant installs from, generated from
#       the venv's own pins. Claude Code reads it live, so it must stay root's.
#     - /opt/hearth/plugins/<name>/<sha>: git's tree at each pin, check's reference (plugin_match).
#     Each step stops on something that exists and differs, never overwrites it.
VENV=/opt/hearth/venv; HPY=$VENV/bin/python; MKT=/opt/hearth/marketplace; REF=/opt/hearth/plugins
repo=$(cd "$here/.." && pwd)
# The venv is judged by content, like every other root-owned thing here (#86): home/venv-state
# compares the installed hearth files and the pinned imports' recorded commits with this checkout.
# A difference (rc 3) is a STOP unless --upgrade was given, because tenants run this interpreter.
# Any other rc, a crash included, is "couldn't compare": a STOP that never reinstalls.
# On a pin bump, --upgrade moves the venv and then the marketplace write below STOPs ("exists and
# differs"): the marketplace is a pin change a person makes on purpose. Remove
# /opt/hearth/marketplace/.claude-plugin/marketplace.json and re-run to finish.
# --- venv begin
if [ -x "$HPY" ]; then
  vrc=0; vs=$("$HPY" -I "$here/venv-state" "$repo" 2>&1) || vrc=$?   # set -e: capture, don't exit
  case $vrc in
    0) echo "= $VENV present, matches this checkout";;
    3) if [ $UPGRADE = 1 ]; then
         echo "$vs" | sed 's/^/  ~ /'
         run "$HPY" -m pip install --quiet --force-reinstall "$repo"
         if [ $DRY = 0 ]; then
           vs=$("$HPY" -I "$here/venv-state" "$repo" 2>&1) \
             || die "$VENV still differs after --upgrade: $(echo "$vs" | tr '\n' ';')"
           echo "= $VENV upgraded, matches this checkout"
         fi
       else
         die "$VENV differs from this checkout: $(echo "$vs" | tr '\n' ';') Re-run with --upgrade to install it (tenants use this interpreter)."
       fi;;
    *) die "couldn't compare $VENV with this checkout: $vs";;
  esac
else
  run /usr/bin/python3 -m venv "$VENV"
  run "$HPY" -m pip install --quiet "$repo"
fi
# --- venv end
if [ $DRY = 1 ] && [ ! -x "$HPY" ]; then
  echo "+ (dry run) no $VENV yet: marketplace, exports and plugin steps below are what it would do"
  HPY=${HEARTH_DRY_PYTHON:-}       # a dev venv with hearth installed, to print the real plan
fi
if [ -n "$HPY" ]; then
  run install -d -o root -g root -m 755 "$MKT" "$REF"
  if [ $DRY = 1 ]; then echo "+ write $MKT/.claude-plugin/marketplace.json:"; "$HPY" -I -m hearth.marketplace render | sed 's/^/    /'
  else "$HPY" -I -m hearth.marketplace write "$MKT" || die "marketplace not written"
       chmod -R a-w,a+rX "$MKT"; fi
  while read -r name url sha sub; do
    d=$REF/$name/$sha
    if [ -e "$d" ]; then echo "= $d present"
    else run install -d -o root -g root -m 755 "$REF/$name"
         run "$HPY" -I -m hearth.plugintree export "$url" "$sha" "$sub" "$d"
         [ $DRY = 1 ] || chmod -R a-w,a+rX "$d"; fi
  done < <("$HPY" -I -m hearth.marketplace exports)
fi

# 5c. The plugins, installed by the tenant itself from root's marketplace (Ash ran this sequence on
#     claude 2.1.288 and 2.1.300 in throwaway configs; not yet on a provisioned tenant). Front Desk's
#     interpreter goes through the CLI's own writer; Tapestry has no plugin option, so its interpreter
#     goes in the settings env block (read, not run: whether it reaches the plugin's server).
#     Front Desk's `home` is left unset on purpose: joining a desk creates an identity, which is
#     Will's to do. check reports it PENDING until then.
CL=$H/.local/bin/claude
plug=$H/.claude/plugins
nolink "$H/.claude" "$plug"
# Every run, no skip (Ash #68 S1): a skip keyed on what installed_plugins.json says would trust a
# tenant-written file. Whether a second `marketplace add` / `install` exits 0 is NOT run; if it
# doesn't, a re-provision stops here loudly (set -e), which is the safe way to find out.
as_t "$CL" plugin marketplace add "$MKT"
as_t "$CL" plugin install tapestry@hearth
as_t "$CL" plugin install frontdesk@hearth
# A repeat install exits 0 and leaves the OLD tree when the pin moved but the plugin's version
# didn't; only uninstall+install moves it, and uninstall wipes the plugin's options (Ash ran both
# on 2.1.288). hearth.pluginsync reinstalls a plugin only if its tree differs from root's export
# at the pin, puts every option back, and stops if claude is running as the tenant. Before the
# configure below, so Front Desk's python is set by provision either way.
for p in tapestry frontdesk; do
  if [ $DRY = 1 ]; then echo "+ $VENV/bin/python -I -m hearth.pluginsync $CL $p   (as $T: reinstall only if the tree differs from the pin, options kept)"
  else sudo -u "$T" -H "$HPY" -I -m hearth.pluginsync "$CL" "$p" || die "plugin $p@hearth isn't at the pin (above)"; fi
done
if [ $DRY = 1 ]; then echo "+ echo '{\"python\":\"$VENV/bin/python\"}' | $CL plugin configure frontdesk@hearth --values-stdin   (as $T)"
else printf '{"python":"%s"}\n' "$VENV/bin/python" | sudo -u "$T" -H "$CL" plugin configure frontdesk@hearth --values-stdin \
       || die "plugin configure frontdesk@hearth failed"; fi
# TAPESTRY_PYTHON into the env block, parsed and rewritten by the tenant's own python, never by root
if [ $DRY = 1 ]; then echo "+ set env.TAPESTRY_PYTHON=$VENV/bin/python in $settings (as $T)"
else sudo -u "$T" -H /usr/bin/python3 -I -c '
import json, os, sys
p, py = sys.argv[1], sys.argv[2]
with open(p) as f: s = json.load(f)
if not isinstance(s, dict) or not isinstance(s.setdefault("env", {}), dict): sys.exit("settings.json env is not an object")
if s["env"].get("TAPESTRY_PYTHON") == py: sys.exit(0)
s["env"]["TAPESTRY_PYTHON"] = py
tmp = p + ".part"
with open(tmp, "w") as f: json.dump(s, f, indent=2); f.write("\n")
os.replace(tmp, p)' "$settings" "$VENV/bin/python" || die "couldn't set TAPESTRY_PYTHON in $settings"; fi

# 5d. The host service (hearth#51): hearth-host@<tenant> runs `python -I -m hearth.host` as the
#     tenant from root's venv, and wakes the tenant's conversations when their messages are due.
#     The unit file is root's, like the judge. It is started only once Front Desk's home is set
#     (Will's step 2 below); before that it would exit 78 at once. Re-runs leave a running one alone.
UNIT_SRC=$here/hearth-host@.service; UNIT_DST=/etc/systemd/system/hearth-host@.service
if [ -e "$UNIT_DST" ] && ! cmp -s "$UNIT_SRC" "$UNIT_DST"; then
  die "$UNIT_DST exists and differs from $UNIT_SRC (another revision?); replace it by hand, then systemctl daemon-reload"
fi
if [ -e "$UNIT_DST" ]; then echo "= $UNIT_DST present"
else run install -o root -g root -m 644 "$UNIT_SRC" "$UNIT_DST"; run systemctl daemon-reload; fi
if [ $DRY = 1 ]; then
  echo "+ systemctl enable --now hearth-host@$T.service   (only if frontdesk_home is GREEN as $T)"
elif sudo -u "$T" -H "$HPY" -I -m hearth.tenantcheck frontdesk_home >/dev/null 2>&1; then
  run systemctl enable --now "hearth-host@$T.service"
else
  echo "= hearth-host@$T not started: Front Desk's home isn't set yet (step 2 below starts it)"
fi

# 6. sudo, proved root-side (from inside, sudo can't tell no-rules from password-rules). Written
#    last, so it is newer than any change this run made; check rejects it once any sudoers file is newer.
run install -d -o root -g root -m 755 "$JUDGE/attest"
if [ $DRY = 1 ]; then echo "+ sudo -l -U $T  -> $JUDGE/attest/$T.sudo"
else
  sl=$(LC_ALL=C sudo -l -U "$T" 2>&1 || true)
  case "$sl" in
    *"is not allowed to run sudo"*)
      printf 'not-allowed %s sudo -l -U %s: %s\n' "$(date -u +%FT%TZ)" "$T" "$(echo "$sl" | head -n 1)" \
        > "$JUDGE/attest/$T.sudo"
      chmod 644 "$JUDGE/attest/$T.sudo";;
    *) die "sudo -l -U $T did not say 'not allowed'; HOME declares no sudo. sudo said: $sl";;
  esac
fi

cat <<EOF

Provisioned $T, apart from the login and the desk. Next, as Will:
  1. sudo -iu $T claude          # then /login, and choose the Max account (the declared loan)
  2. Front Desk identity, which provision doesn't create (it's an identity on a desk):
     sudo -iu $T $VENV/bin/frontdesk join $T --answerable <you>
     sudo -iu $T sh -c 'echo "{\"home\":\"\$HOME/.frontdesk/$T\"}" | claude plugin configure frontdesk@hearth --values-stdin'
     sudo systemctl enable --now hearth-host@$T     # the host that wakes its conversations
     Until then check reports channel_home PENDING and host RED, and the run fails.
  3. sudo -iu $T $JUDGE/check
     It must be GREEN apart from cc_memory/sudo (ABSENT, declared), custody_in (KNOWN while any
     other account has root) and other_plugins (KNOWN if anything outside @hearth is enabled).
     Any RED or PENDING, stop and send it to Foil.
  4. Custody, from outside (check can't prove it from inside a sandbox). Every line must FAIL:
     sudo -u foil ls /home/$T ; sudo -u refsdal ls /home/$T                    # read
     sudo -u foil stat /home/$T/.hearth/ledger.jsonl                           # traverse (--x reach)
     sudo -u refsdal stat /home/$T/.hearth/ledger.jsonl
     sudo -u $T ls /home/foil /home/refsdal ; sudo -u $T stat /home/foil/agent-health
     (will CAN stat /home/$T/.hearth/ledger.jsonl: that's the declared u:will:--x.)
EOF
