#!/usr/bin/env bash
# home/controls — positive and negative controls for check's inventory guards.
# Runs a temporary copy of check against temporary inventories, with --no-model, and asserts only
# the guard lines (environment-dependent items like custody or sudo are ignored). Exits non-zero
# if any guard stopped working. Needs no provisioned tenant; any user can run it.
set -u
here=$(dirname "$(readlink -f "$0")")
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
fail=0
# check with its fixed inventory path pointed at a scratch file
sed "s#^DEFAULT_INV=/opt/hearth/home/inventory#DEFAULT_INV=$t/inventory#" "$here/check" > "$t/check"
grep -q "^DEFAULT_INV=$t/inventory" "$t/check" || { echo "FAIL could not retarget DEFAULT_INV"; exit 1; }
chmod +x "$t/check"
nreq=$(grep -oE '^REQUIRED="[^"]*"' "$here/check" | tr -cd ' ' | wc -c); nreq=$((nreq + 1))

run() { "$1" --no-model > "$t/out" 2>&1; echo $?; }
expect() { # name, condition-result (0 = held), detail
  if [ "$2" = 0 ]; then echo "ok   $1"; else echo "FAIL $1: $3"; fail=1; fi
}

# 1. populated installed list: no guard fires (so the guards don't RED a correct list)
cp "$here/inventory" "$t/inventory"; run "$t/check" >/dev/null
n=$(grep -cE 'required as|missing or unreadable|not the installed inventory' "$t/out")
expect "populated inventory: no guard line" $([ "$n" = 0 ]; echo $?) "$n guard lines: $(grep -E 'required as|missing' "$t/out")"

# 2. empty list: every required item RED, run fails
: > "$t/inventory"; rc=$(run "$t/check")
n=$(grep -c 'required as' "$t/out")
expect "empty inventory: $nreq required REDs, rc!=0" $([ "$n" = "$nreq" ] && [ "$rc" != 0 ]; echo $?) "n=$n rc=$rc"

# 3. missing list: says so, run fails
rm -f "$t/inventory"; rc=$(run "$t/check")
expect "missing inventory: RED, rc!=0" $(grep -q 'missing or unreadable' "$t/out" && [ "$rc" != 0 ]; echo $?) "rc=$rc"

# 4. a required item given a weaker check: RED for that item
sed 's/no_sudo$/declared_absent/' "$here/inventory" > "$t/inventory"; rc=$(run "$t/check")
expect "sudo swapped to declared_absent: RED, rc!=0" \
  $(grep -q '^RED    sudo        required as' "$t/out" && [ "$rc" != 0 ]; echo $?) "rc=$rc"

# 5. some other inventory path: never passes
cp "$here/inventory" "$t/other"; "$t/check" --no-model "$t/other" > "$t/out" 2>&1; rc=$?
expect "non-installed inventory: RED, rc!=0" \
  $(grep -q 'not the installed inventory' "$t/out" && [ "$rc" != 0 ]; echo $?) "rc=$rc"

# 6. the controls can fail: with the required loop deleted, control 2 must no longer hold
sed '/^for r in \$REQUIRED/,/^done$/d' "$t/check" > "$t/broken"; chmod +x "$t/broken"
: > "$t/inventory"; run "$t/broken" >/dev/null
n=$(grep -c 'required as' "$t/out")
expect "guard deleted: control 2 would catch it" $([ "$n" != "$nreq" ]; echo $?) "still $n required lines"

# 7. nothing from the caller's environment reaches check: a BASH_ENV file (sourced by bash before
# the first line) and a planted `stat` first on PATH must both stay silent
mkdir -p "$t/bin"; printf '#!/bin/sh\necho PLANTED-PATH\n' > "$t/bin/stat"; chmod +x "$t/bin/stat"
printf 'echo PLANTED-BASH_ENV\n' > "$t/env"
cp "$here/inventory" "$t/inventory"
BASH_ENV="$t/env" PATH="$t/bin:$PATH" HOME_CHECK_CLEAN=1 "$t/check" --no-model > "$t/out" 2>&1
expect "caller env (BASH_ENV, PATH) doesn't reach check" $(! grep -q PLANTED "$t/out"; echo $?) \
  "$(grep PLANTED "$t/out" | sort -u | tr '\n' ' ')"

# 8. the tenant's own ~/.local/bin can't shadow the judge's tools. This plants a `stat` in the
# real ~/.local/bin of whoever runs controls, so it is skipped if one is already there, and the
# plant is removed on exit.
plant="$HOME/.local/bin/stat"
if [ -e "$plant" ]; then
  echo "SKIP tenant-shadowed tool: $plant already exists, so nothing was tested"; fail=1
else
  mkdir -p "$HOME/.local/bin"; printf '#!/bin/sh\necho PLANTED-HOME\n' > "$plant"; chmod +x "$plant"
  trap 'rm -f "$plant"; rm -rf "$t"' EXIT
  "$t/check" --no-model > "$t/out" 2>&1; rm -f "$plant"
  expect "tenant ~/.local/bin doesn't shadow check's tools" $(! grep -q PLANTED "$t/out"; echo $?) \
    "$(grep PLANTED "$t/out" | sort -u | tr '\n' ' ')"
fi

# 9. root-equivalent groups: a group the runner is in, added to ROOT_GROUPS, turns sudo RED; and
# provision denies exactly check's list (a relationship, so neither can drift without the other).
mine=$(id -gn)
sed "s/^ROOT_GROUPS=\"/ROOT_GROUPS=\"$mine /" "$t/check" > "$t/rg"; chmod +x "$t/rg"
cp "$here/inventory" "$t/inventory"; "$t/rg" --no-model > "$t/out" 2>&1
expect "member of a ROOT_GROUPS group: sudo RED" $(grep -q "^RED    sudo        in root-equivalent group $mine" "$t/out"; echo $?) \
  "$(grep '^[A-Z]* *sudo ' "$t/out")"
cg=$(grep -oE '^ROOT_GROUPS="[^"]*"' "$here/check" | cut -d'"' -f2 | tr ' ' '\n' | sort | xargs)
pg=$(grep -oE '^for g in [a-z ]+; do$' "$here/provision" | sed -n 's/^for g in \(.*\); do$/\1/p' \
     | grep -w docker | tr ' ' '\n' | sort | xargs)
expect "provision denies check's ROOT_GROUPS ($cg)" $([ -n "$cg" ] && [ "$cg" = "$pg" ]; echo $?) \
  "check [$cg], provision [$pg]"

# 10. inbound custody is KNOWN or RED, never GREEN, and KNOWN alone doesn't fail the run
printf 'custody_in | own | tenant | OS user boundary | inbound_custody\n' > "$t/inventory"
sed 's/^REQUIRED=".*"$/REQUIRED="custody_in:inbound_custody"/' "$t/check" > "$t/ci"; chmod +x "$t/ci"
"$t/ci" --no-model > "$t/out" 2>&1; rc=$?
line=$(grep -E '^[A-Z]+ +custody_in' "$t/out")
case "$line" in
  KNOWN*) expect "inbound custody KNOWN, run passes (rc 0)" $([ $rc = 0 ]; echo $?) "rc=$rc: $line";;
  RED*)   expect "inbound custody RED, run fails" $([ $rc != 0 ]; echo $?) "rc=$rc: $line";;
  *)      expect "inbound custody never GREEN" 1 "$line";;
esac
sed 's/^ROOT_GROUPS=".*"$/ROOT_GROUPS=""/' "$t/ci" > "$t/ci0"; chmod +x "$t/ci0"
"$t/ci0" --no-model > "$t/out" 2>&1; rc=$?
expect "no root account found: RED (unverified), not GREEN" \
  $(grep -q '^RED    custody_in  .*unverified' "$t/out" && [ $rc != 0 ]; echo $?) "rc=$rc: $(grep custody_in "$t/out")"

# 11. a provisioning marker the runner plants in its own home doesn't make provision touch it.
# Runs provision --dry-run on the runner's own account (changes nothing). Skipped is a failure.
mark="$HOME/.hearth-provisioned"
if [ -e "$mark" ]; then
  echo "SKIP forged marker: $mark already exists, so nothing was tested"; fail=1
else
  : > "$mark"
  "$here/provision" --dry-run "$(id -un)" > "$t/out" 2>&1; rc=$?; rm -f "$mark"
  expect "forged in-home marker: provision refuses (not in registry)" \
    $(grep -q "isn't in /var/lib/hearth/tenants" "$t/out" && [ $rc != 0 ]; echo $?) "rc=$rc: $(head -3 "$t/out" | tr '\n' ' ')"
fi

# 12. sudo needs a root-side attestation: missing, says-allowed and older-than-sudoers are RED;
# a fresh not-allowed one is the only pass. Ownership is retargeted to the runner for the test.
me=$(id -un); mkdir "$t/att"
sed "s#^ATTEST_DIR=.*#ATTEST_DIR=$t/att; ATTEST_OWNER=$me#" "$t/check" > "$t/sa"; chmod +x "$t/sa"
grep -q "^ATTEST_DIR=$t/att" "$t/sa" || { echo "FAIL could not retarget ATTEST_DIR"; fail=1; }
cp "$here/inventory" "$t/inventory"
sl() { "$t/sa" --no-model 2>&1 | grep -E '^[A-Z]+ +sudo '; }
rg=$(grep -oE '^ROOT_GROUPS="[^"]*"' "$here/check" | cut -d'"' -f2); inroot=""
for r in $rg; do case " $(id -nG) " in *" $r "*) inroot=$r;; esac; done
if [ -n "$inroot" ]; then echo "SKIP 12: runner is in root group $inroot, so sudo is RED before the attestation is read"; fail=1; else
  l=$(sl); expect "sudo, no attestation: RED" $(case "$l" in "RED    sudo        no root-side attestation"*) echo 0;; *) echo 1;; esac) "$l"
  echo "allowed (ALL) ALL" > "$t/att/$me.sudo"
  l=$(sl); expect "sudo, attestation says allowed: RED" $(case "$l" in RED*"attestation says"*) echo 0;; *) echo 1;; esac) "$l"
  echo "not-allowed test" > "$t/att/$me.sudo"; touch -d 2000-01-01 "$t/att/$me.sudo"
  l=$(sl); expect "sudo, attestation older than sudoers: RED" $(case "$l" in RED*"changed after the attestation"*) echo 0;; *) echo 1;; esac) "$l"
  touch "$t/att/$me.sudo"
  l=$(sl); expect "sudo, fresh not-allowed attestation: passes" $(case "$l" in ABSENT*"root-side: not-allowed"*) echo 0;; *) echo 1;; esac) "$l"
fi

# 13. a link the tenant planted in its home stops provision, and its target is untouched. Runs
# provision's step 4 (the ledger) on a scratch home, with the tenant played by the runner. A real
# re-run is root acting on a tenant's home, and chmod follows links, so an unrefused
# ledger.jsonl -> /etc/shadow would end up world-readable.
step4=$(sed -n '/^# 4\. ledger/,/^# 5\./p' "$here/provision")
nl=$(grep -E '^nolink\(\) ' "$here/provision")
mkdir -p "$t/h13/.hearth" && printf 'secret\n' > "$t/target13" && chmod 600 "$t/target13"
ln -s "$t/target13" "$t/h13/.hearth/ledger.jsonl"
( DRY=0; T=$(id -un); H=$t/h13
  run() { "$@"; }; as_t() { "$@"; }; tq() { "$@"; }; die() { echo "STOP: $*"; exit 1; }
  eval "$nl"; eval "$step4" ) > "$t/out" 2>&1; rc=$?
m=$(stat -c %a "$t/target13")
expect "planted ledger link: provision STOPs, target stays 600" \
  $(grep -q '^STOP: .*ledger.jsonl is a symlink' "$t/out" && [ $rc != 0 ] && [ "$m" = 600 ]; echo $?) \
  "rc=$rc mode=$m: $(head -2 "$t/out" | tr '\n' ' ')"

# 14. root runs nothing on a path inside the tenant's home except the home itself (step 2). Every
# command naming a path under $H, or one derived from it, goes through as_t or tq.
bad=$(grep -nE '^[[:space:]]*(run|install|chmod|chown|cmp|grep|cp|mv|ln|touch|setfacl)[[:space:]][^#]*("\$H/|\$(dst|vdir|link|settings|ledger)\b)' "$here/provision" \
      | grep -vE 'as_t|tq ' || true)
expect "no root command on a path under the tenant's home" $([ -z "$bad" ]; echo $?) "$bad"
# ...and no root-side test that follows links (-e -f -d -r -w -x -s) on such a path, in any of the
# forms [ ], [ ! ], [[ ]] or a bare `test`. [ -L ] is lstat, so it stays allowed; a following test
# must go through `tq test`. The pattern is checked against planted variants below.
# Limit (Ash's note on #34): this greps the source, so it guards these forms, not the class. It
# misses stat without -L, a path built in a subshell, and any new variable naming a path under $H.
# The rule it enforces is the header's (root does nothing inside the tenant's home); review is
# still what holds it.
fpat='(\[\[?|(^|[^q] )test) +(! +)?-[efdrwxs] +"?\$(H/|(dst|vdir|link|settings|ledger)\b)'
bad=$(grep -nE "$fpat" "$here/provision" || true)
expect "no root-side following test on a path under the tenant's home" $([ -z "$bad" ]; echo $?) "$bad"
# The pattern must catch every root-side form and spare the allowed ones (red arm of the line above).
miss=""
for l in '[ -e "$H/.hearth" ]' '[ ! -e "$H/x" ]' '[[ -e "$H/x" ]]' 'test -e "$H/x"' 'if test -f "$ledger"; then' '[ -d $vdir ]'; do
  printf '%s\n' "$l" | grep -qE "$fpat" || miss="$miss missed:[$l]"
done
for l in 'tq test -e "$link"' '[ -L "$link" ]' '[ -e "$linkage" ]'; do
  printf '%s\n' "$l" | grep -qE "$fpat" && miss="$miss flagged:[$l]"
done
expect "following-test pattern catches [ ], [ ! ], [[ ]], bare test; spares tq and -L" $([ -z "$miss" ]; echo $?) "$miss"

# 16. the model path, which every other control skips with --no-model. A check that reads stdin
# must not consume the inventory: the first real run (buster, main 507784f) lost every line after
# oauth because claude -p read the rest of the list as its prompt. Stub claude reads all of stdin,
# then answers HOME-OK; every item after oauth must still get its own verdict line.
cat > "$t/claude" <<'EOF'
#!/bin/sh
[ "$1" = --version ] && { echo "0.0.0 (stub)"; exit 0; }
cat > /dev/null
echo '{"result":"HOME-OK"}'
EOF
chmod +x "$t/claude"
# check's model turn runs from the runner's passwd home; with none (e.g. under `unshare -U`, which
# maps the runner to nobody, home /nonexistent) the turn fails either way, so the control can't
# tell a fix from no fix. Same treatment as 12: SKIP is a failure, never a pass.
rh=$(getent passwd "$(id -un)" | cut -d: -f6)
if [ ! -d "$rh" ]; then
  echo "SKIP 16: runner $(id -un) has no home directory ($rh), so the model path can't run here"; fail=1
else
sed "s#^CLAUDE=.*#CLAUDE=$t/claude#" "$t/check" > "$t/mc"; chmod +x "$t/mc"
grep -q "^CLAUDE=$t/claude" "$t/mc" || { echo "FAIL could not retarget CLAUDE"; fail=1; }
cp "$here/inventory" "$t/inventory"; "$t/mc" > "$t/out" 2>&1
after=$(grep -v '^\s*#' "$here/inventory" | sed '/^\s*$/d' | sed -n '/model_turn/,$p' | sed 1d | cut -d'|' -f1 | xargs)
missing=""
for i in $after; do grep -qE "^[A-Z]+ +$i " "$t/out" || missing="$missing $i"; done
expect "model path: oauth GREEN via stub, and every later item ($after) still evaluated" \
  $(grep -q '^GREEN  oauth ' "$t/out" && [ -n "$after" ] && [ -z "$missing" ] && ! grep -q 'required as' "$t/out"; echo $?) \
  "missing:$missing; $(grep -E 'oauth|required as' "$t/out" | tr '\n' ' ')"
fi

# 17. memory declared absent is tested, not taken on trust. Buster's first turn left Claude Code
# auto-memory files while check printed "declared absent". check is pointed at a scratch home
# (MEM_HOME): empty must be ABSENT; each way of holding memory must be RED, including the ways a
# tenant could hide it from a naive find (Ash's P1-P3 on #42); and an inventory that swaps
# no_memory back to declared_absent must be caught as required.
m=$t/mem; mkdir -p "$m"
sed -e "s#^MEM_HOME=.*#MEM_HOME=$m; CLAUDE_HOME=$m/.claude#" "$t/check" > "$t/memc"; chmod +x "$t/memc"
grep -q "^MEM_HOME=$m; " "$t/memc" || { echo "FAIL could not retarget MEM_HOME"; fail=1; }
cp "$here/inventory" "$t/inventory"
memreset() { chmod -R u+rwx "$m" 2>/dev/null; rm -rf "$m"; mkdir -p "$m/.claude/projects/-home-x"; }
memrun() { "$t/memc" --no-model > "$t/out" 2>&1; }
memred() { # name: expect memory RED (present, or couldn't look) in the current scratch home
  memrun; expect "memory: $1 is RED" $(grep -qE '^RED    cc_memory   .*(memory present|couldn.t look|can.t read|can.t rule out)' "$t/out"; echo $?) "$(grep ' cc_memory ' "$t/out")"
}
memreset; memrun
expect "memory: empty scratch home is ABSENT" $(grep -q '^ABSENT cc_memory ' "$t/out"; echo $?) "$(grep ' cc_memory ' "$t/out")"
memreset; mkdir -p "$m/.claude/projects/-home-x/memory"; echo "user prefers tabs" > "$m/.claude/projects/-home-x/memory/MEMORY.md"
memred "an auto-memory file"
memreset; echo "remember this" > "$m/CLAUDE.md"; memred "a home CLAUDE.md"
memreset; echo "remember this" > "$m/CLAUDE.local.md"; memred "a home CLAUDE.local.md"
memreset; mkdir -p "$m/.claude/rules"; echo "always x" > "$m/.claude/rules/r.md"; memred "a user rule in ~/.claude/rules"
memreset; mkdir -p "$m/elsewhere"; echo "hidden" > "$m/elsewhere/MEMORY.md"
ln -s "$m/elsewhere" "$m/.claude/projects/-home-x/memory"; memred "P1, memory/ as a symlink to a dir with a file"
memreset; mkdir -p "$m/.claude/projects/-home-x/memory"; echo "hidden" > "$m/notes"
ln -s "$m/notes" "$m/.claude/projects/-home-x/memory/MEMORY.md"; memred "P2, MEMORY.md as a symlink"
# a link to nothing yet: the tenant can create the target during its own turn, after check has run
memreset; mkdir -p "$m/.claude/projects/-home-x/memory"
ln -s "$m/later" "$m/.claude/projects/-home-x/memory/MEMORY.md"; memred "a dangling MEMORY.md link"
if [ "$(id -u)" = 0 ]; then echo "SKIP memory P3: root reads a mode-000 dir, so it can't be tested as root"; fail=1
else
memreset; mkdir -p "$m/.claude/projects/-home-x/memory"; echo "hidden" > "$m/.claude/projects/-home-x/memory/MEMORY.md"
chmod 000 "$m/.claude/projects/-home-x/memory"; memred "P3, a mode-000 memory/ with a file inside"
fi
memreset; echo '{"autoMemoryDirectory": "~/elsewhere"}' > "$m/.claude/settings.json"; memred "a relocated auto-memory dir (autoMemoryDirectory)"
# the same key spelled with a JSON \u escape: parses to autoMemoryDirectory, invisible to a byte grep
memreset; printf '%s\n' '{"autoMemory\u0044irectory": "/tmp/x"}' > "$m/.claude/settings.json"; memred "an escaped autoMemoryDirectory key"
memreset; echo '{"env": {"x": {"claudeMd": "remember"}}}' > "$m/.claude/settings.local.json"; memred "a nested claudeMd key"
memreset; echo '{"autoMemoryEnabled": false, // not json' > "$m/.claude/settings.json"; memred "an unparseable settings.json"
# a FIFO for settings.json: open() would block and check would never return. Under a timeout, so a
# regression shows as a FAIL here, not a hung controls run.
memreset; mkfifo "$m/.claude/settings.json"
timeout 20 "$t/memc" --no-model > "$t/out" 2>&1; frc=$?
expect "memory: a FIFO settings.json is RED and check returns" \
  $([ $frc != 124 ] && grep -qE '^RED    cc_memory   .*not a regular file' "$t/out"; echo $?) "rc=$frc $(grep ' cc_memory ' "$t/out")"
# a sparse 1 GiB settings.json: costs the tenant no disk, but an unbounded read costs the judge RAM.
# Under ulimit -v, so the bound itself is tested, not just the verdict: an unbounded read with the
# same length check still says "too large" when memory is free, but here it can't allocate and
# reports "unparseable: MemoryError" instead (Wren's mutation on #42).
memreset; truncate -s 1G "$m/.claude/settings.json"
( ulimit -v 262144; "$t/memc" --no-model ) > "$t/out" 2>&1
expect "memory: a 1 GiB sparse settings.json is RED as too large, within 256 MiB" \
  $(grep -qE '^RED    cc_memory   .*too large' "$t/out"; echo $?) "$(grep ' cc_memory ' "$t/out")"
memreset; echo '{"autoMemoryEnabled": false, "env": {"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"}}' > "$m/.claude/settings.json"; memrun
expect "memory: provision's settings.json alone is still ABSENT" $(grep -q '^ABSENT cc_memory ' "$t/out"; echo $?) "$(grep ' cc_memory ' "$t/out")"
memreset; sed 's/| no_memory$/| declared_absent/' "$here/inventory" > "$t/inventory"; memrun
expect "memory: declared_absent in place of no_memory is RED as required" \
  $(grep -q '^RED    cc_memory   .*required as cc_memory:no_memory' "$t/out"; echo $?) "$(grep ' cc_memory ' "$t/out")"
cp "$here/inventory" "$t/inventory"; memreset

# 18. what the loaned login reaches is KNOWN, never GREEN: synced skills are listed by name (tenant
# text sanitised), a place check can't look into is RED, and the line can't be dropped.
loanrun() { "$t/memc" --no-model > "$t/out" 2>&1; grep ' loan_reach ' "$t/out"; }
memreset; l=$(loanrun)
expect "loan: no synced skills is KNOWN with 0, not GREEN" $(echo "$l" | grep -qE '^KNOWN  loan_reach .*skills synced: 0;'; echo $?) "$l"
memreset; s="$m/.claude/skills/synced"; mkdir -p "$s/0b1c" "$s/9f2e"
printf -- '---\nname: import-memory\n---\nbody\n' > "$s/0b1c/SKILL.md"
printf -- '---\nname: x\033[31mred\n---\n' > "$s/9f2e/SKILL.md"; l=$(loanrun)
expect "loan: synced skills KNOWN by name, escape bytes stripped" \
  $(echo "$l" | grep -qE '^KNOWN  loan_reach .*skills synced: 2 \[import-memory x31mred\]' && ! echo "$l" | grep -q $'\033'; echo $?) "$(echo "$l" | cat -v)"
expect "loan: synced skills don't make memory RED" $(grep -q '^ABSENT cc_memory ' "$t/out"; echo $?) "$(grep ' cc_memory ' "$t/out")"
if [ "$(id -u)" = 0 ]; then echo "SKIP loan mode-000: root reads a mode-000 dir"; fail=1
else
memreset; mkdir -p "$m/.claude/skills/synced/0b1c"; chmod 000 "$m/.claude/skills/synced"; l=$(loanrun)
expect "loan: a synced dir check can't read is RED" $(echo "$l" | grep -q '^RED    loan_reach .*couldn.t look'; echo $?) "$l"
fi
# a FIFO SKILL.md (Ash on #47): opening it would block, so check must still return. Under a timeout.
memreset; mkdir -p "$m/.claude/skills/synced/b"; mkfifo "$m/.claude/skills/synced/b/SKILL.md"
timeout 20 "$t/memc" --no-model > "$t/out" 2>&1; frc=$?; l=$(grep ' loan_reach ' "$t/out")
expect "loan: a FIFO SKILL.md reads as '?' and check returns" \
  $([ $frc != 124 ] && echo "$l" | grep -qF 'skills synced: 1 [?]'; echo $?) "rc=$frc $l"
memreset; grep -v '^loan_reach ' "$here/inventory" > "$t/inventory"; l=$(loanrun)
expect "loan: dropping the line is RED as required" $(echo "$l" | grep -q 'required as loan_reach:loan_reach'; echo $?) "$l"
cp "$here/inventory" "$t/inventory"; memreset

# 19. Hearth's plugin items (docs/decisions/0009). check hands them to hearth.tenantcheck in the
# root venv, whose own tests cover the judging; these hold check's side. A stand-in interpreter
# answers with a fixed exit code, so no venv or tenant is needed.
sed "s#^HEARTH_PY=/opt/hearth/venv/bin/python#HEARTH_PY=$t/fakepy#" "$t/check" > "$t/plc"; chmod +x "$t/plc"
grep -q "^HEARTH_PY=$t/fakepy" "$t/plc" || { echo "FAIL could not retarget HEARTH_PY"; fail=1; }
fake() { printf '#!/bin/sh\necho "stand-in $*"\nexit %s\n' "$1" > "$t/fakepy"; chmod +x "$t/fakepy"; }
fake 5; cp "$here/inventory" "$t/inventory"; rc=$(run "$t/plc")
expect "plugins: PENDING prints PENDING" \
  $(grep -q '^PENDING channel_home .*stand-in -I -m hearth.tenantcheck frontdesk_home' "$t/out"; echo $?) "$(grep channel_home "$t/out")"
# rc alone, on a one-item run (other items are RED wherever this runs, so the full run's rc says
# nothing): GREEN must exit 0 and PENDING must not.
sed 's/^REQUIRED=".*"$/REQUIRED="channel_home:frontdesk_home"/' "$t/plc" > "$t/pl1"; chmod +x "$t/pl1"
grep '^channel_home' "$here/inventory" > "$t/inventory"
fake 0; rc0=$(run "$t/pl1"); fake 5; rc5=$(run "$t/pl1")
expect "plugins: PENDING alone fails the run, GREEN alone passes" $([ "$rc0" = 0 ] && [ "$rc5" != 0 ]; echo $?) "GREEN rc=$rc0, PENDING rc=$rc5"
cp "$here/inventory" "$t/inventory"
fake 4; rc=$(run "$t/plc")
expect "plugins: KNOWN prints KNOWN" $(grep -q '^KNOWN  other_plugins ' "$t/out"; echo $?) "$(grep other_plugins "$t/out")"
fake 0; rc=$(run "$t/plc")
expect "plugins: each row asks for its own plugin" \
  $(grep -q '^GREEN  memory .*plugin_match tapestry' "$t/out" && grep -q '^GREEN  channel .*plugin_match frontdesk' "$t/out"; echo $?) "$(grep -E ' (memory|channel) ' "$t/out")"
sed 's/| plugin_match:tapestry$/| plugin_match:frontdesk/' "$here/inventory" > "$t/inventory"; rc=$(run "$t/plc")
expect "plugins: memory judging frontdesk instead is RED as required" \
  $(grep -q '^RED    memory .*required as memory:plugin_match:tapestry' "$t/out"; echo $?) "$(grep ' memory ' "$t/out")"
rm -f "$t/fakepy"; cp "$here/inventory" "$t/inventory"; rc=$(run "$t/plc")
expect "plugins: no root venv is RED, not skipped" $(grep -q '^RED    memory .*no .*fakepy (provision step 5b)' "$t/out"; echo $?) "$(grep ' memory ' "$t/out")"

fake 0; cp "$here/inventory" "$t/inventory"; rc=$(run "$t/plc")
expect "host: the row asks tenantcheck host_running" \
  $(grep -q '^GREEN  host .*stand-in -I -m hearth.tenantcheck host_running' "$t/out"; echo $?) "$(grep ' host ' "$t/out")"
grep -v '^host ' "$here/inventory" > "$t/inventory"; rc=$(run "$t/plc")
expect "host: dropping the line is RED as required" $(grep -q 'required as host:host_running' "$t/out"; echo $?) "$(grep ' host ' "$t/out")"
cp "$here/inventory" "$t/inventory"

# 20. the unit provision installs runs the host as the tenant, from root's venv, isolated
u="$here/hearth-host@.service"
expect "unit: User=%i and Group=%i" $(grep -qx 'User=%i' "$u" && grep -qx 'Group=%i' "$u"; echo $?) "$(grep -E '^(User|Group)=' "$u")"
want="ExecStart=$(grep -oE '^HEARTH_PY=[^ ]+' "$here/check" | cut -d= -f2) -I -m hearth.host"
expect "unit: ExecStart is check's HEARTH_PY -I -m hearth.host" $(grep -qxF "$want" "$u"; echo $?) "$(grep ^ExecStart= "$u"), want $want"
expect "unit: no environment from a file the tenant could write" $(! grep -qE '^(EnvironmentFile|ExecStartPre)=' "$u"; echo $?) "$(grep -E '^(EnvironmentFile|ExecStartPre)=' "$u")"

# 21. provision's step 5d run for real (DRY=0) on scratch paths, with systemctl and the tenant's
# python stood in: installs the unit once, stops on a different one, and starts the service only
# when frontdesk_home is GREEN as the tenant.
step5d=$(sed -n '/^# 5d\. /,/^# 6\. /p' "$here/provision" | sed "s#UNIT_DST=/etc/systemd/system/#UNIT_DST=$t/units/#")
echo "$step5d" | grep -q "UNIT_DST=$t/units/" || { echo "FAIL could not retarget UNIT_DST"; fail=1; }
d5() {   # $1 = frontdesk_home rc the stand-in python gives
  printf '#!/bin/sh\nexit %s\n' "$1" > "$t/hpy5"; chmod +x "$t/hpy5"; : > "$t/sysctl.log"
  ( DRY=0; T=tenant5; here=$here; HPY=$t/hpy5
    run() { "$@"; }; die() { echo "STOP: $*"; exit 1; }
    install() { mkdir -p "$t/units"; cp "${@: -2:1}" "${@: -1}"; }    # owner/mode need root
    systemctl() { echo "$*" >> "$t/sysctl.log"; }
    sudo() { shift 3; "$@"; }                                         # sudo -u T -H cmd...
    eval "$step5d" ) > "$t/out" 2>&1; echo $?
}
rm -rf "$t/units"; rc=$(d5 1)
expect "5d: unit installed, not started while frontdesk_home isn't GREEN" \
  $([ "$rc" = 0 ] && cmp -s "$here/hearth-host@.service" "$t/units/hearth-host@.service" \
    && grep -qx daemon-reload "$t/sysctl.log" && ! grep -q enable "$t/sysctl.log"; echo $?) "rc=$rc $(cat "$t/sysctl.log" "$t/out" | tr '\n' ' ')"
rc=$(d5 0)
expect "5d: present unit kept, service started when frontdesk_home is GREEN" \
  $([ "$rc" = 0 ] && grep -qx 'enable --now hearth-host@tenant5.service' "$t/sysctl.log" && ! grep -qx daemon-reload "$t/sysctl.log"; echo $?) \
  "rc=$rc $(cat "$t/sysctl.log" "$t/out" | tr '\n' ' ')"
echo '# edited' >> "$t/units/hearth-host@.service"; rc=$(d5 0)
expect "5d: a different unit is a STOP, nothing started" \
  $([ "$rc" != 0 ] && grep -q '^STOP: .*hearth-host@.service exists and differs' "$t/out" && [ ! -s "$t/sysctl.log" ]; echo $?) \
  "rc=$rc $(cat "$t/sysctl.log" "$t/out" | tr '\n' ' ')"

# 22. provision 5c brings each plugin to the pin through hearth.pluginsync, as the tenant, and stops
# if it fails; before Front Desk's python is configured. (pluginsync's own behaviour: tests/.)
c5=$(sed -n '/^# 5c\. /,/^# 5d\. /p' "$here/provision")
expect "5c: pluginsync runs for both plugins, as the tenant, and a failure stops provision" \
  $(echo "$c5" | grep -q '^for p in tapestry frontdesk; do$' \
    && echo "$c5" | grep -qF 'else sudo -u "$T" -H "$HPY" -I -m hearth.pluginsync "$CL" "$p" || die '; echo $?) \
  "$(echo "$c5" | grep -n pluginsync)"
ps=$(echo "$c5" | grep -n 'hearth.pluginsync "$CL"' | cut -d: -f1); cf=$(echo "$c5" | grep -n 'plugin configure frontdesk@hearth --values-stdin \\' | cut -d: -f1)
expect "5c: pluginsync comes before the python configure" $([ -n "$ps" ] && [ -n "$cf" ] && [ "$ps" -lt "$cf" ]; echo $?) "pluginsync l.$ps, configure l.$cf"

exit $fail
